{
  "cli": {
    "version": ">= 7.6.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:4000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://emeelan.in/els-ai/api",
        "EXPO_PUBLIC_TTS_URL": "https://emeelan.in/els-ai/tts"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://emeelan.in/els-ai/api",
        "EXPO_PUBLIC_TTS_URL": "https://emeelan.in/els-ai/tts"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
