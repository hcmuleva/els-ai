    {
      "entity_id": "formula_d849b106df",
      "entity_type": "Formula",
      "name": "The formula for average velocity is v = d / t, where d is displacement and t is time.",
      "concept_id": "concept_864bdb0ca9",
      "book_id": "book_97d5fcbb5a",
      "source_pages": [
        1
      ]
    },
    {
      "entity_id": "example_d849b106df",
      "entity_type": "Example",
      "name": "For example, a car that travels 100 metres in 5 seconds has an average velocity of 20 metres per second.",
      "concept_id": "concept_864bdb0ca9",
