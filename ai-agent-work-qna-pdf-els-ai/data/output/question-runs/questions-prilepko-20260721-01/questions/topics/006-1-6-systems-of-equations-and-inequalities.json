    {
      "question": {
        "id": "8105e6af-b985-53fd-97ae-a43f78ff147b",
        "quiz_id": "quiz-0c244d8c1145",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "Find the general solution of the system \\(x+y+z=6,\\ 2x+3y+4z=16,\\ 3x+4y+5z=22\\), where \\(x,y,z\\in\\mathbb{R}\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "Subtracting twice the first equation from the second gives \\(y+2z=4\\). Thus \\(y=4-2z\\), and the first equation gives \\(x=2+z\\). Setting \\(z=t\\) yields \\((x,y,z)=(2+t,4-2t,t)\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
