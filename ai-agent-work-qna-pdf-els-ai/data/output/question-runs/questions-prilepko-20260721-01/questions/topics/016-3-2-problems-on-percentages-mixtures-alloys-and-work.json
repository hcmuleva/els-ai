          "options": [
            {
              "id": "20_mathrm_kg_1",
              "label": "\\(20\\\\ \\\\mathrm{kg}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "The required mixing ratio is \\(A:B=2:3\\), giving \\(20\\\\ \\\\mathrm{kg}\\) of \\(A\\)."
            },
            {
              "id": "25_mathrm_kg_2",
              "label": "\\(25\\\\ \\\\mathrm{kg}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "This corresponds to equal quantities, which do not give \\(60\\\\%\\) copper."
            },
            {
              "id": "30_mathrm_kg_3",
              "label": "\\(30\\\\ \\\\mathrm{kg}\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "This reverses the relative quantities of the two alloys."
            },
            {
              "id": "15_mathrm_kg_4",
              "label": "\\(15\\\\ \\\\mathrm{kg}\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "This does not satisfy the copper balance equation."
