      "question": {
        "id": "9e20f5a0-f0bb-5f19-a8ce-b4af10c84f19",
        "quiz_id": "quiz-0c244d8c1145",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "A vessel contains \\(60\\ \\\\mathrm{L}\\) of a milk-water mixture in the ratio \\(3:2\\). If \\(x\\\\ \\\\mathrm{L}\\) of the mixture is removed and replaced with water twice, the final ratio of milk to water becomes \\(27:73\\). Find \\(x\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "Initially, the milk fraction is \\(\\frac{3}{5}\\). After two replacements, \\(\\frac{3}{5}\\left(1-\\frac{x}{60}\\right)^2=\\frac{27}{100}\\), so \\(1-\\frac{x}{60}=\\frac{3}{2\\\\sqrt{5}}\\). Hence \\(x=60-18\\\\sqrt{5}\\\\ \\\\mathrm{L}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 68,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
