    {
      "question": {
        "id": "9c21d3ec-d758-5e63-af61-545e1112c57c",
        "quiz_id": "quiz-0c244d8c1145",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "Alloy \\(A\\) contains copper and zinc in the ratio \\(5:3\\), while alloy \\(B\\) contains them in the ratio \\(7:5\\). How much alloy \\(A\\) must be mixed with alloy \\(B\\) to obtain \\(50\\\\ \\\\mathrm{kg}\\) of an alloy containing \\(60\\\\% \\) copper?",
        "question_instruction": "Choose one correct option.",
        "explanation": "The copper fractions are \\(\\frac{5}{8}\\) and \\(\\frac{7}{12}\\). If the quantities are \\(a\\) and \\(b\\), then \\(\\frac{5}{8}a+\\frac{7}{12}b=\\frac{3}{5}(a+b)\\), which gives \\(a:b=2:3\\). Therefore, \\(a=\\frac{2}{5}\\times 50=20\\\\ \\\\mathrm{kg}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 69,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Analyze",
            "topic": "3.2 Problems on Percentages, Mixtures, Alloys, and Work",
            "concept_ids": [
