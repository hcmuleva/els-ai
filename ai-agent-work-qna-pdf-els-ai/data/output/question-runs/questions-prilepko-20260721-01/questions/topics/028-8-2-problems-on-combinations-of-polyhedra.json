      "question": {
        "id": "65778c3c-fce8-55f7-a8bf-3369192e31e0",
        "quiz_id": "quiz-0c244d8c1145",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "A right circular cylinder has radius \\(R\\). A plane passing through the centre of its lower base makes an angle \\(\\alpha\\) with the base and cuts the upper base in a chord of length \\(b\\), which subtends a minor arc of \\(\\beta^\\circ\\) at the centre. The volume of the cylinder is",
        "question_instruction": "Choose one correct option.",
        "explanation": "The chord relation gives \\(b=2R\\\\sin\\\\left(\\\\frac{\\\\beta}{2}\\\\right)\\). Its distance from the centre is \\(R\\\\cos\\\\left(\\\\frac{\\\\beta}{2}\\\\right)\\), so the cylinder height is \\(R\\\\cos\\\\left(\\\\frac{\\\\beta}{2}\\\\right)\\\\tan\\\\alpha\\). Hence \\(V=\\\\pi R^2h=\\\\frac{\\\\pi b^3\\\\tan\\\\alpha\\\\cos(\\\\beta/2)}{8\\\\sin^3(\\\\beta/2)}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 128,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
