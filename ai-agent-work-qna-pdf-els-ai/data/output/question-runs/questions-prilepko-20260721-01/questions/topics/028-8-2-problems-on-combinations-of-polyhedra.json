              "rationale": "The perpendicular distance from the centre to the chord is omitted."
            },
            {
              "id": "frac_pi_b_3_cot_alpha_co_3",
              "label": "\\(\\\\frac{\\\\pi b^3\\\\cot\\\\alpha\\\\cos\\\\left(\\\\frac{\\\\beta}{2}\\\\right)}{8\\\\sin^3\\\\left(\\\\frac{\\\\beta}{2}\\\\right)}\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "The height varies directly with \\(\\\\tan\\\\alpha\\), not \\(\\\\cot\\\\alpha\\)."
            },
            {
              "id": "frac_pi_b_3_tan_alpha_si_4",
              "label": "\\(\\\\frac{\\\\pi b^3\\\\tan\\\\alpha\\\\sin\\\\left(\\\\frac{\\\\beta}{2}\\\\right)}{8\\\\cos^3\\\\left(\\\\frac{\\\\beta}{2}\\\\right)}\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "The chord-distance relation uses cosine, while the chord length uses sine."
            }
