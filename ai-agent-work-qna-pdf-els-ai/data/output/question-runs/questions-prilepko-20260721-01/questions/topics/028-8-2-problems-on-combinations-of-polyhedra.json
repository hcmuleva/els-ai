          "options": [
            {
              "id": "frac_pi_b_3_tan_alpha_co_1",
              "label": "\\(\\\\frac{\\\\pi b^3\\\\tan\\\\alpha\\\\cos\\\\left(\\\\frac{\\\\beta}{2}\\\\right)}{8\\\\sin^3\\\\left(\\\\frac{\\\\beta}{2}\\\\right)}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "\\(R=\\\\frac{b}{2\\\\sin(\\\\beta/2)}\\) and height \\(=R\\\\cos(\\\\beta/2)\\\\tan\\\\alpha\\)."
            },
            {
              "id": "frac_pi_b_3_tan_alpha_8_2",
              "label": "\\(\\\\frac{\\\\pi b^3\\\\tan\\\\alpha}{8\\\\sin^2\\\\left(\\\\frac{\\\\beta}{2}\\\\right)}\\)",
