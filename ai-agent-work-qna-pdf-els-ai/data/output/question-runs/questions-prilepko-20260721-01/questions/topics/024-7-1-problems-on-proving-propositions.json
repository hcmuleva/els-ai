            {
              "id": "G_4_4_and_AG_GD_2_1_wher_1",
              "label": "\\(G=(4,4)\\) and \\(AG:GD=2:1\\), where \\(D\\) is the midpoint of \\(BC\\).",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "The centroid is the average of the vertex coordinates and divides each median in the ratio \\(2:1\\)."
            },
