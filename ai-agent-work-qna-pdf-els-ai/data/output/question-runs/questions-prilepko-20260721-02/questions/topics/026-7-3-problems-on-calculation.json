        "question_type": "single_choice",
        "question_title": "In a triangle \\(ABC\\), \\(AB=13\\text{ cm}\\), \\(BC=14\\text{ cm}\\), and \\(AC=15\\text{ cm}\\). What is the cosine of its largest interior angle?",
        "question_instruction": "Choose one correct option.",
        "explanation": "The largest angle is \\(\\angle B\\), opposite \\(AC=15\\text{ cm}\\). Thus, \\(\\cos B=\\frac{13^2+14^2-15^2}{2\\cdot13\\cdot14}=\\frac{5}{13}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 126,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
