          "options": [
            {
              "id": "Draw_BC_a_at_B_draw_a_ra_1",
              "label": "Draw \\(BC=a\\); at \\(B\\), draw a ray making angle \\(\\beta\\) with \\(BC\\); mark \\(D\\) on it with \\(BD=s\\); the intersection of this ray with the perpendicular bisector of \\(CD\\) is \\(A\\).",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "For \\(A\\) on \\(BD\\), \\(BD=BA+AD\\); the perpendicular bisector gives \\(AD=AC\\), hence \\(AB+AC=s\\)."
            },
            {
              "id": "Draw_BC_a_mark_D_with_BD_2",
              "label": "Draw \\(BC=a\\), mark \\(D\\) with \\(BD=s\\), and take \\(A\\) as the midpoint of \\(CD\\).",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "The midpoint condition does not impose \\(\\angle ABC=\\beta\\) or the required side sum."
            },
            {
              "id": "Draw_BC_a_construct_angl_3",
              "label": "Draw \\(BC=a\\), construct angle \\(\\beta\\) at \\(B\\), and mark \\(BA=s\\).",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "This sets \\(AB=s\\), leaving no construction condition for \\(AC\\)."
            },
            {
              "id": "Draw_BC_a_construct_the_4",
              "label": "Draw \\(BC=a\\), construct the perpendicular bisector of \\(BC\\), and choose any point \\(A\\) on it.",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "Points on this bisector satisfy \\(AB=AC\\), not \\(AB+AC=s\\) with a prescribed angle."
            }
