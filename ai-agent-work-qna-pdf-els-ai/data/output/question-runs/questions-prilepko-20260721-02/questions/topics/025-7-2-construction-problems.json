              "label": "At \\(P\\), draw any two lines meeting the given circle, and choose the shorter segments.",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "A tangent must meet the circle at exactly one point and be perpendicular to the corresponding radius."
            }
