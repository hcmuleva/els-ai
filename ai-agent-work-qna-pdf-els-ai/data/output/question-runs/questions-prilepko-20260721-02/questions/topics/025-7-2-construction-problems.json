          },
          "options": [
            {
              "id": "Construct_the_image_of_r_1",
              "label": "Construct the image of ray \\(OX\\) under a half-turn about \\(A\\), let it meet \\(OY\\) at \\(Q\\), reflect \\(Q\\) about \\(A\\) to obtain \\(P\\), and draw \\(PQ\\).",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "The half-turn ensures \\(A\\) is the midpoint of \\(PQ\\), with \\(P\\) on \\(OX\\) and \\(Q\\) on \\(OY\\)."
            },
            {
              "id": "Draw_the_angle_bisector_2",
              "label": "Draw the angle bisector through \\(A\\) and mark equal lengths on both arms.",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "Equal distances on the arms do not ensure that the intercepted points and \\(A\\) are collinear."
            },
            {
              "id": "Draw_a_perpendicular_fro_3",
              "label": "Draw a perpendicular from \\(A\\) to \\(OX\\), then join its foot to \\(OY\\).",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "This construction does not generally make \\(A\\) the midpoint of the intercepted segment."
            },
            {
              "id": "Reflect_ray_OY_in_the_an_4",
              "label": "Reflect ray \\(OY\\) in the angle bisector and join its intersection with \\(OX\\) to \\(A\\).",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "Reflection in the angle bisector does not impose the midpoint condition about \\(A\\)."
            }
          ],
