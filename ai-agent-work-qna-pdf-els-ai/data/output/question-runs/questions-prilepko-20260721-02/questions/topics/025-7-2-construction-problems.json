        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "Let \\(A\\) lie inside the angle formed by the rays \\(OX\\) and \\(OY\\). Which construction correctly draws a line through \\(A\\) such that \\(A\\) is the midpoint of the segment intercepted on the two rays?",
        "question_instruction": "Choose one correct option.",
        "explanation": "A half-turn about \\(A\\) maps \\(P\\) to \\(Q\\) exactly when \\(A\\) is the midpoint of \\(PQ\\). Thus, intersecting the half-turn image of one arm with the other arm gives the required construction.",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 121,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
