              "concept_a7d0197ca3"
            ],
            "source": "rag:math-prilepko-20260721-05:3.3",
            "source_run_id": "math-prilepko-20260721-05",
            "source_book_id": "book_f2847eeae3",
            "source_pages": [
              82,
              83,
              84,
              222,
              223
            ],
