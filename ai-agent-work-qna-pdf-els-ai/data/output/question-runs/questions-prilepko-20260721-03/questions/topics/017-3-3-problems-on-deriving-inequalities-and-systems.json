    {
      "question": {
        "id": "09ab95df-41c3-582b-8b51-b4d5a1ed76af",
        "quiz_id": "quiz-e2315d04f14a",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "A tank is filled by pipe \\(P\\), which fills \\(\\frac{1}{12}\\) of the tank per hour. A drain empties \\(\\frac{1}{36}\\) of the tank per hour, and pipe \\(Q\\) fills \\(\\frac{1}{18}\\) of the tank per hour. Pipe \\(P\\) and the drain remain open for \\(10\\) hours, while pipe \\(Q\\) is open for \\(x\\) hours. If the tank becomes full, find \\(x\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "The net rate due to pipe \\(P\\) and the drain is \\(\\frac{1}{12}-\\frac{1}{36}=\\frac{1}{18}\\). Therefore, \\(\\frac{10}{18}+\\frac{x}{18}=1\\), so \\(x=8\\) hours.",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 83,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
