    {
      "question": {
        "id": "2fb072fa-bd6f-5614-a454-f238636acad2",
        "quiz_id": "quiz-6c7ee0837188",
        "quiz_title": "Prilepko Mathematics Topic Question Bank (Validated Diagrams)",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "A regular square pyramid has each lateral face making an angle \\(\\alpha\\) with its base. A sphere of radius \\(r\\) is inscribed in the pyramid. A plane through the centre of the sphere and parallel to the base cuts the pyramid. The area of the section is",
        "question_instruction": "Choose one correct option.",
        "explanation": "Let the pyramid height be \\(h\\) and base side be \\(a\\). From the axial section, \\(a=2h\\cot\\alpha\\). If \\(l\\) is the slant height, then the insphere relation gives \\(r=\\frac{h}{1+\\sec\\alpha}\\). The section through the sphere centre has side \\(a\\left(1-\\frac{r}{h}\\right)=2r\\csc\\alpha\\). Therefore its area is \\(4r^2\\csc^2\\alpha=\\frac{4r^2}{\\sin^2\\alpha}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 137,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Analyze",
