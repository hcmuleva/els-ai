        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "\\(y\\) varies inversely as \\(x\\). If \\(y=12\\) when \\(x=3\\), find \\(y\\) when \\(x=8\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "For inverse proportionality, \\(xy=k\\). Thus \\(k=3\\times12=36\\), and \\(y=\\frac{36}{8}=\\frac{9}{2}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 11,
        "question_data": {
