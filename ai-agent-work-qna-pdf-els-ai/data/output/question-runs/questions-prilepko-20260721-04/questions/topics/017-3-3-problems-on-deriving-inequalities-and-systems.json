      "question": {
        "id": "8ab739e4-f106-51ec-8584-a6d83bffcc74",
        "quiz_id": "quiz-6c7ee0837188",
        "quiz_title": "Prilepko Mathematics Topic Question Bank (Validated Diagrams)",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "Three pieces of a copper-tin alloy have masses in the ratio \\(3:4:5\\). The copper percentage in the second piece is \\(a\\) times that in the third piece, while that in the first piece is \\(\\frac{1}{a}\\) times that in the third piece. If the overall copper percentage is \\(30\\%\\) and \\(a>1\\), find \\(a\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "Let the copper percentage in the third piece be \\(p\\). Then \\(\\frac{3(p/a)+4(ap)+5p}{12}=30\\), so \\(4a+\\frac{3}{a}+5=18\\). Hence \\(4a^2-13a+3=0\\), giving \\(a=3\\) or \\(\\frac{1}{4}\\). Since \\(a>1\\), \\(a=3\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 81,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Apply",
            "topic": "3.3 Problems on Deriving Inequalities and Systems",
