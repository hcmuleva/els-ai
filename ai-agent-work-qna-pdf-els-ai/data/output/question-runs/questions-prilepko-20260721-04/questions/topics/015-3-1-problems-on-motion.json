        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "If \\(0<x<\\frac{\\pi}{2}\\), which inequality is always true?",
        "question_instruction": "Choose one correct option.",
        "explanation": "Let \\(t=\\tan\\frac{x}{2}\\). Then \\(0<t<1\\), and \\(\\tan x=\\frac{2t}{1-t^2}>2t=2\\tan\\frac{x}{2}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 73,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Apply",
            "topic": "3.1 Problems on Motion",
            "concept_ids": [
              "concept_55243fb7b8",
              "concept_80f2b383f9"
            ],
            "source": "rag:math-prilepko-20260721-05:3.1",
            "source_run_id": "math-prilepko-20260721-05",
            "source_book_id": "book_f2847eeae3",
            "source_pages": [
              71,
