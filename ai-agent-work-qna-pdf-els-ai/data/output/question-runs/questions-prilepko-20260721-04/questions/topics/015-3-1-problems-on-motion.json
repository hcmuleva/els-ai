              75,
              76,
              220
            ],
            "source_chunk_ids": [
              "chunk_1768849c3d",
              "chunk_cf83fe5906"
            ]
          },
          "options": [
            {
              "id": "tan_x_2_tan_frac_x_2_1",
              "label": "\\(\\tan x>2\\tan\\frac{x}{2}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "Use \\(\\tan x=\\frac{2t}{1-t^2}\\), where \\(t=\\tan\\frac{x}{2}\\in(0,1)\\)."
            },
            {
              "id": "tan_x_2_tan_frac_x_2_2",
              "label": "\\(\\tan x<2\\tan\\frac{x}{2}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "The denominator \\(1-t^2\\) is less than \\(1\\)."
            },
            {
              "id": "tan_x_2_tan_frac_x_2_3",
              "label": "\\(\\tan x=2\\tan\\frac{x}{2}\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "This would require \\(t=0\\)."
            },
            {
              "id": "tan_x_le_tan_frac_x_2_4",
              "label": "\\(\\tan x\\le\\tan\\frac{x}{2}\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "Tangent is increasing on this range."
            }
          ],
          "variant": "single_choice",
          "diagram": null
        },
        "created_at": "2026-07-21T15:33:04.157682Z",
        "question_svg": null
