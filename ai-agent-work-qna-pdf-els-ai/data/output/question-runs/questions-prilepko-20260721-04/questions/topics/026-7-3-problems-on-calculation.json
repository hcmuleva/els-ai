    {
      "question": {
        "id": "9c0540d4-0127-5682-b98e-bfe240252e45",
        "quiz_id": "quiz-6c7ee0837188",
        "quiz_title": "Prilepko Mathematics Topic Question Bank (Validated Diagrams)",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "Using Heron's formula, find the area of a triangle whose side lengths are \\(13\\text{ cm}\\), \\(14\\text{ cm}\\), and \\(15\\text{ cm}\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "The semiperimeter is \\(s=\\frac{13+14+15}{2}=21\\text{ cm}\\). Hence, \\(S=\\sqrt{s(s-13)(s-14)(s-15)}=\\sqrt{21\\cdot8\\cdot7\\cdot6}=84\\text{ cm}^2\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 127,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Apply",
            "topic": "7.3 Problems on Calculation",
            "concept_ids": [
              "concept_52319e8fbb",
              "concept_d29f22e744"
            ],
            "source": "rag:math-prilepko-20260721-05:7.3",
            "source_run_id": "math-prilepko-20260721-05",
            "source_book_id": "book_f2847eeae3",
            "source_pages": [
              109,
