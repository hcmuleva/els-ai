          "options": [
            {
              "id": "frac_5_13_1",
              "label": "\\(\\frac{5}{13}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "The largest angle is opposite \\(AC=15\\text{ cm}\\), so the cosine rule gives \\(\\frac{13^2+14^2-15^2}{2\\cdot13\\cdot14}=\\frac{5}{13}\\)."
            },
            {
              "id": "frac_7_13_2",
              "label": "\\(\\frac{7}{13}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "This does not result from applying the cosine rule to the largest angle."
            },
            {
              "id": "frac_5_14_3",
              "label": "\\(\\frac{5}{14}\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "The denominator in the cosine rule is \\(2\\cdot13\\cdot14\\), not \\(14\\)."
            },
            {
              "id": "frac_13_15_4",
              "label": "\\(\\frac{13}{15}\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "This is not the cosine-rule value for the angle opposite the side of length \\(15\\text{ cm}\\)."
            }
