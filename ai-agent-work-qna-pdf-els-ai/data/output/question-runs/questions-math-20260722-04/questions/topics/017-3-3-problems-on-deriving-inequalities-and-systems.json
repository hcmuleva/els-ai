      "question": {
        "id": "91710b6a-ddcd-5c9f-83ce-b0b7733280cb",
        "quiz_id": "quiz-6a352a6209b5",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "Three pieces of a copper-tin alloy have masses in the ratio \\(3:4:5\\). The copper percentage in the third piece is \\(p\\%\\), while those in the first and second pieces are \\(\\frac{p}{2}\\%\\) and \\(2p\\%\\), respectively. If the overall copper percentage is \\(24\\%\\), find \\(p\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "The copper percentage of the mixture is \\(\\frac{3(p/2)+4(2p)+5p}{3+4+5}=\\frac{29p}{24}\\). Hence \\(\\frac{29p}{24}=24\\), so \\(p=\\frac{576}{29}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 81,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
