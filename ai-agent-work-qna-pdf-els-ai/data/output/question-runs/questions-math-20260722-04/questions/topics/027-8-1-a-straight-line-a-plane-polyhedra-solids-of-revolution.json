{
  "key": "8.1",
  "topic": "8.1 A Straight Line, a Plane, Polyhedra, Solids of Revolution",
  "questions": [
    {
      "question": {
        "id": "6d55fb7a-0a6c-5514-967b-985d4782fb38",
        "quiz_id": "quiz-6a352a6209b5",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "Two congruent right triangles \\(ABC\\) and \\(ABD\\) lie in mutually perpendicular planes, have common hypotenuse \\(AB\\), and satisfy \\(AB=10\\,\\mathrm{cm}\\), \\(AC=AD=6\\,\\mathrm{cm}\\), and \\(BC=BD=8\\,\\mathrm{cm}\\). If \\(C\\) and \\(D\\) are the right-angle vertices, find \\(CD\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "The altitude from either right-angle vertex to \\(AB\\) is \\(h=\\frac{AC\\cdot BC}{AB}=\\frac{24}{5}\\,\\mathrm{cm}\\). Since the planes are perpendicular, the two offsets are perpendicular, so \\(CD=\\sqrt{h^2+h^2}=\\frac{24\\sqrt{2}}{5}\\,\\mathrm{cm}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 131,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Apply",
            "topic": "8.1 A Straight Line, a Plane, Polyhedra, Solids of Revolution",
            "concept_ids": [
              "concept_165743b2c0",
              "concept_322bf2bf32"
            ],
            "source": "rag:math-prilepko-20260721-05:8.1",
            "source_run_id": "math-prilepko-20260721-05",
            "source_book_id": "book_f2847eeae3",
            "source_pages": [
              114,
              115,
              116,
              117,
              118,
              251,
              252,
              253,
              254,
              255
            ],
            "source_chunk_ids": [
              "chunk_961ef424a5",
              "chunk_e4f765bc02"
            ]
          },
          "options": [
            {
              "id": "frac_24_sqrt_2_5_mathrm_1",
              "label": "\\(\\frac{24\\sqrt{2}}{5}\\,\\mathrm{cm}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "The altitude to \\(AB\\) is \\(\\frac{6\\cdot8}{10}=\\frac{24}{5}\\,\\mathrm{cm}\\); perpendicular offsets give \\(CD=\\frac{24\\sqrt{2}}{5}\\,\\mathrm{cm}\\)."
            },
            {
              "id": "frac_24_5_mathrm_cm_2",
              "label": "\\(\\frac{24}{5}\\,\\mathrm{cm}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "This is the altitude to the common hypotenuse, not \\(CD\\)."
            },
            {
              "id": "frac_48_5_mathrm_cm_3",
              "label": "\\(\\frac{48}{5}\\,\\mathrm{cm}\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "The perpendicular offsets must be combined using the Pythagorean theorem."
            },
            {
              "id": "12_mathrm_cm_4",
              "label": "\\(12\\,\\mathrm{cm}\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "This value does not account for the perpendicular-plane geometry."
            }
          ],
          "variant": "single_choice",
          "diagram": null
        },
        "created_at": "2026-07-22T10:13:40.843740Z",
        "question_svg": null
      }
    },
    {
      "question": {
        "id": "2f0ece18-5fb2-50dd-b28e-7a798bcd31d4",
        "quiz_id": "quiz-6a352a6209b5",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "In a regular tetrahedron \\(ABCD\\) of edge length \\(a\\), \\(M\\) and \\(N\\) are the midpoints of opposite edges \\(AB\\) and \\(CD\\). Find \\(MN\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "Take vertices proportional to \\((1,1,1)\\), \\((1,-1,-1)\\), \\((-1,1,-1)\\), and \\((-1,-1,1)\\). The edge length is \\(2\\sqrt{2}\\), while the opposite-edge midpoints are \\((1,0,0)\\) and \\((-1,0,0)\\), separated by \\(2\\). Hence \\(MN=\\frac{2}{2\\sqrt{2}}a=\\frac{a}{\\sqrt{2}}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 132,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Apply",
            "topic": "8.1 A Straight Line, a Plane, Polyhedra, Solids of Revolution",
            "concept_ids": [
              "concept_165743b2c0",
              "concept_322bf2bf32"
            ],
            "source": "rag:math-prilepko-20260721-05:8.1",
            "source_run_id": "math-prilepko-20260721-05",
            "source_book_id": "book_f2847eeae3",
            "source_pages": [
              114,
              115,
              116,
              117,
              118,
              251,
              252,
              253,
              254,
              255
            ],
            "source_chunk_ids": [
              "chunk_961ef424a5",
              "chunk_e4f765bc02"
            ]
          },
          "options": [
            {
              "id": "frac_a_sqrt_2_1",
              "label": "\\(\\frac{a}{\\sqrt{2}}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "The midpoint segment joining opposite edges of a regular tetrahedron has length \\(\\frac{a}{\\sqrt{2}}\\)."
            },
            {
              "id": "frac_a_2_2",
              "label": "\\(\\frac{a}{2}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "This is not the distance between the midpoints of opposite edges."
            },
            {
              "id": "a_3",
              "label": "\\(a\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "The midpoint segment is shorter than an edge."
            },
            {
              "id": "a_sqrt_2_4",
              "label": "\\(a\\sqrt{2}\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "This exceeds the edge length and is inconsistent with the tetrahedron geometry."
            }
          ],
          "variant": "single_choice",
          "diagram": null
        },
        "created_at": "2026-07-22T10:13:40.843740Z",
        "question_svg": null
      }
