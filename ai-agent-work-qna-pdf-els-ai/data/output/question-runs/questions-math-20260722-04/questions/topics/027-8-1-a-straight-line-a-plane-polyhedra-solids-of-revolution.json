        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "The region in the first quadrant bounded by \\(y=x^2\\), \\(y=0\\), and \\(x=2\\) is revolved about the \\(x\\)-axis. Find the volume of the resulting solid.",
        "question_instruction": "Choose one correct option.",
        "explanation": "At position \\(x\\), the disk radius is \\(x^2\\). Thus \\(V=\\pi\\int_0^2x^4\\,dx=\\pi\\left[\\frac{x^5}{5}\\right]_0^2=\\frac{32\\pi}{5}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 134,
        "question_data": {
