          "options": [
            {
              "id": "frac_32_pi_5_1",
              "label": "\\(\\frac{32\\pi}{5}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "Using washers, \\(V=\\pi\\int_0^2(x^2)^2\\,dx=\\frac{32\\pi}{5}\\)."
            },
            {
              "id": "frac_16_pi_5_2",
              "label": "\\(\\frac{16\\pi}{5}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "The radius must be squared, giving \\(x^4\\), not \\(x^2\\)."
            },
            {
              "id": "8_pi_3",
              "label": "\\(8\\pi\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "The radius varies with \\(x\\), so a constant-radius formula is invalid."
