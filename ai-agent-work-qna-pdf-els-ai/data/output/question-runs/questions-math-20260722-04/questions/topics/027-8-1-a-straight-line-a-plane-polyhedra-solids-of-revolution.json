            {
              "id": "frac_64_pi_5_4",
              "label": "\\(\\frac{64\\pi}{5}\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "This is twice the correct washer integral."
            }
