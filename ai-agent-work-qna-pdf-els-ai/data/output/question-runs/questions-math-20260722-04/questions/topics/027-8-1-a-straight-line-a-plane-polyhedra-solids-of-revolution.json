    {
      "question": {
        "id": "65f9c411-de97-5824-97c4-e6c2cbcf0e56",
        "quiz_id": "quiz-6a352a6209b5",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "The plane \\(2x-y+2z=9\\) meets the coordinate axes at \\(A\\), \\(B\\), and \\(C\\), respectively. If \\(O\\) is the origin, find the volume of tetrahedron \\(OABC\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "The intercepts are \\(A=(\\frac{9}{2},0,0)\\), \\(B=(0,-9,0)\\), and \\(C=(0,0,\\frac{9}{2})\\). Therefore, \\(V=\\frac{1}{6}\\left|\\frac{9}{2}(-9)\\frac{9}{2}\\right|=\\frac{243}{8}\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 133,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Apply",
            "topic": "8.1 A Straight Line, a Plane, Polyhedra, Solids of Revolution",
            "concept_ids": [
              "concept_165743b2c0",
              "concept_322bf2bf32"
            ],
            "source": "rag:math-prilepko-20260721-05:8.1",
            "source_run_id": "math-prilepko-20260721-05",
            "source_book_id": "book_f2847eeae3",
            "source_pages": [
              114,
              115,
              116,
              117,
              118,
              251,
              252,
              253,
              254,
              255
            ],
            "source_chunk_ids": [
              "chunk_961ef424a5",
              "chunk_e4f765bc02"
            ]
          },
          "options": [
            {
              "id": "frac_243_8_1",
              "label": "\\(\\frac{243}{8}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "The intercepts are \\(\\frac{9}{2}\\), \\(-9\\), and \\(\\frac{9}{2}\\); their absolute product divided by \\(6\\) is \\(\\frac{243}{8}\\)."
            },
            {
              "id": "frac_729_8_2",
              "label": "\\(\\frac{729}{8}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "This omits the tetrahedron factor \\(\\frac{1}{6}\\)."
            },
            {
              "id": "frac_81_8_3",
              "label": "\\(\\frac{81}{8}\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "The intercept magnitudes have not been multiplied correctly."
            },
            {
              "id": "frac_243_4_4",
              "label": "\\(\\frac{243}{4}\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "The intercept product has been divided by \\(3\\) rather than \\(6\\)."
            }
          ],
          "variant": "single_choice",
          "diagram": null
        },
        "created_at": "2026-07-22T10:13:40.843740Z",
        "question_svg": null
      }
