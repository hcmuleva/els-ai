    {
      "question": {
        "id": "664a1d24-e232-56b4-8047-8b7341786601",
        "quiz_id": "quiz-6a352a6209b5",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "A positive quantity \\(y\\) varies inversely as a positive quantity \\(x\\). If \\(x\\) changes from \\(5\\) to \\(8\\), the percentage decrease in \\(y\\) is",
        "question_instruction": "Choose one correct option.",
        "explanation": "For inverse proportionality, \\(xy\\) is constant. Thus \\(\\frac{y_2}{y_1}=\\frac{x_1}{x_2}=\\frac{5}{8}\\). The decrease is \\(1-\\frac{5}{8}=\\frac{3}{8}=37.5\\%\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 11,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Apply",
            "topic": "1.3 Inverse Proportionality",
            "concept_ids": [
              "concept_2c57fddca7",
              "concept_5e078c2130"
            ],
            "source": "rag:math-prilepko-20260721-05:1.3",
            "source_run_id": "math-prilepko-20260721-05",
            "source_book_id": "book_f2847eeae3",
            "source_pages": [
              18,
              19,
              20,
              149,
              150,
              151
            ],
            "source_chunk_ids": [
              "chunk_9118d80f41",
              "chunk_574daf3a3a"
            ]
          },
          "options": [
            {
              "id": "37_5_1",
              "label": "\\(37.5\\%\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "Since \\(y\\propto\\frac{1}{x}\\), the ratio is \\(\\frac{5}{8}\\), giving a decrease of \\(\\frac{3}{8}\\)."
            },
            {
              "id": "30_2",
              "label": "\\(30\\%\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "This does not use the inverse ratio correctly."
            },
            {
              "id": "60_3",
              "label": "\\(60\\%\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "This incorrectly uses the ratio \\(\\frac{8}{5}\\)."
            },
            {
              "id": "62_5_4",
              "label": "\\(62.5\\%\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "This is the final ratio expressed as a percentage, not the decrease."
            }
          ],
          "variant": "single_choice",
          "diagram": null
        },
        "created_at": "2026-07-22T10:13:40.843740Z",
        "question_svg": null
      }
