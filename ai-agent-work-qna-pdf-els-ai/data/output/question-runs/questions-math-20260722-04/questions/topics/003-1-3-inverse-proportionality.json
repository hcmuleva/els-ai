    {
      "question": {
        "id": "ab6dc9a7-98f8-54fc-af4d-2aca1e0e2322",
        "quiz_id": "quiz-6a352a6209b5",
        "quiz_title": "Prilepko Mathematics Topic Question Bank",
        "class_level": "Class 12",
        "subject": "Mathematics",
        "quiz_type": "single_choice",
        "question_type": "single_choice",
        "question_title": "The quantity \\(P\\) varies inversely as \\(\\sqrt{q}\\). If \\(P=10\\) when \\(q=4\\), find \\(P\\) when \\(q=25\\).",
        "question_instruction": "Choose one correct option.",
        "explanation": "Since \\(P\\propto\\frac{1}{\\sqrt{q}}\\), \\(P\\sqrt{q}=k\\). Hence \\(k=10\\sqrt{4}=20\\), and \\(P=\\frac{20}{\\sqrt{25}}=4\\).",
        "question_audio": null,
        "time_limit_seconds": 30,
        "points": 10,
        "sort_order": 12,
        "question_data": {
          "_meta": {
            "subject": "Mathematics",
            "creatorId": null,
            "classLevel": "Class 12",
            "organizationId": null,
            "level_band": "jee_main",
            "bloom_level": "Apply",
            "topic": "1.3 Inverse Proportionality",
            "concept_ids": [
              "concept_2c57fddca7",
              "concept_5e078c2130"
            ],
            "source": "rag:math-prilepko-20260721-05:1.3",
            "source_run_id": "math-prilepko-20260721-05",
            "source_book_id": "book_f2847eeae3",
            "source_pages": [
              18,
              19,
              20,
              149,
              150,
              151
            ],
            "source_chunk_ids": [
              "chunk_9118d80f41",
              "chunk_574daf3a3a"
            ]
          },
          "options": [
            {
              "id": "4_1",
              "label": "\\(4\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "\\(P\\sqrt{q}\\) is constant, so \\(P=20/\\sqrt{25}=4\\)."
            },
            {
              "id": "5_2",
              "label": "\\(5\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "This treats the variation as inverse proportionality to \\(q\\), not \\(\\sqrt{q}\\)."
            },
            {
              "id": "8_3",
              "label": "\\(8\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "This does not preserve the constant product \\(P\\sqrt{q}\\)."
            },
            {
              "id": "20_4",
              "label": "\\(20\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "This corresponds to using the initial constant without dividing by \\(\\sqrt{25}\\)."
            }
          ],
          "variant": "single_choice",
          "diagram": null
        },
