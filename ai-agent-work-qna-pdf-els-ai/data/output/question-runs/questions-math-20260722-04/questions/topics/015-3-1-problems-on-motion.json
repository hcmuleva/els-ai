              "label": "\\(x=-\\sqrt{a}\\) and \\(x=\\sqrt{a}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "\\(f'(x)=3(x^2-a)\\), and the derivative changes from negative to positive at \\(\\sqrt a\\)."
            },
            {
              "id": "x_sqrt_a_and_x_sqrt_a_2",
              "label": "\\(x=\\sqrt{a}\\) and \\(x=-\\sqrt{a}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "The classifications are reversed."
