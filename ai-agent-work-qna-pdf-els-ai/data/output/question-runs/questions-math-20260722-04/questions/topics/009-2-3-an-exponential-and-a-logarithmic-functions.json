          "options": [
            {
              "id": "4_sqrt_2_1",
              "label": "\\(4+\\sqrt{2}\\)",
              "is_correct": true,
              "slot_position": 1,
              "svg": null,
              "diagram": null,
              "rationale": "Putting \\(t=\\log _2x\\) gives \\(t=2\\) or \\(t=\\frac12\\), hence \\(x=4\\) or \\(x=\\sqrt2\\)."
            },
            {
              "id": "4_sqrt_2_2",
              "label": "\\(4-\\sqrt{2}\\)",
              "is_correct": false,
              "slot_position": 2,
              "svg": null,
              "diagram": null,
              "rationale": "The two valid values of \\(x\\) must be added, not subtracted."
            },
            {
              "id": "2_sqrt_2_3",
              "label": "\\(2+\\sqrt{2}\\)",
              "is_correct": false,
              "slot_position": 3,
              "svg": null,
              "diagram": null,
              "rationale": "The value \\(x=2\\) does not satisfy the equation."
            },
            {
              "id": "5_4",
              "label": "\\(5\\)",
              "is_correct": false,
              "slot_position": 4,
              "svg": null,
              "diagram": null,
              "rationale": "The equation does not imply that the sum equals its right-hand side."
            }
