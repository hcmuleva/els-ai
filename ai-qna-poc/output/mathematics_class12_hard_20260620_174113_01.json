        },
        {
          "id": "q2_opt_2",
          "slot_position": 2,
          "label_markdown": "$9$",
          "is_correct": false
        },
        {
          "id": "q2_opt_3",
          "slot_position": 3,
          "label_markdown": "$8$",
          "is_correct": false
