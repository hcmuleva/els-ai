    {
      "id": "MAT12_CALCULUS_JM_003",
      "questionType": "AssertionReason",
      "difficulty": "JEE_Main",
      "bloomLevel": "Understand",
      "marks": 4,
      "chapter": "Calculus",
      "topic": "Differentiation and applications of derivatives",
      "question": "Assertion (A): $\\dfrac{d}{dx}(\\sin x) = \\cos x$.\nReason (R): From first principles, $\\dfrac{d}{dx}\\sin x = \\lim_{h\\to 0}\\dfrac{\\sin(x+h)-\\sin x}{h}$, which simplifies to $\\cos x$ using $\\lim_{h\\to0}\\frac{\\sin h}{h}=1$.",
      "options": [
        {
          "key": "A",
          "text": "Both A and R are true and R is the correct explanation of A."
        },
        {
          "key": "B",
          "text": "Both A and R are true but R is NOT the correct explanation of A."
        },
        {
          "key": "C",
          "text": "A is true but R is false."
        },
        {
          "key": "D",
          "text": "A is false but R is true."
        }
      ],
      "correctAnswer": "A",
      "solution": {
        "finalAnswer": "Both A and R are true and R correctly explains A.",
        "stepByStep": [
          "Expand $\\sin(x+h) = \\sin x\\cos h + \\cos x\\sin h$.",
          "The difference quotient becomes $\\sin x\\frac{\\cos h - 1}{h} + \\cos x\\frac{\\sin h}{h}$.",
          "As $h\\to0$: $\\frac{\\cos h - 1}{h}\\to 0$ and $\\frac{\\sin h}{h}\\to 1$, giving $\\cos x$."
        ],
        "formulaUsed": [
          "d/dx sin x = cos x"
        ],
        "commonMistake": "Quoting the result without recognising it follows from the standard limit.",
        "examinerNote": "R is precisely the derivation of A."
      },
      "qualityChecks": {
        "syllabusAligned": true,
        "classLevelMatched": true,
        "answerVerified": false,
        "noAmbiguity": true,
        "notTooEasy": true,
        "notCopiedFromKnownPaper": true
      },
