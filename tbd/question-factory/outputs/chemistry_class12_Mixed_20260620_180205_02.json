        }
      ],
      "correctAnswer": "A",
      "solution": {
        "finalAnswer": "$10\\ \\text{s}$",
        "stepByStep": [
          "First-order half-life: $t_{1/2} = 0.693/k$.",
          "$t_{1/2} = 0.693/0.0693 = 10\\ \\text{s}$."
