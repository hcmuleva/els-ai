    {
      "id": "CHE12_CHEMICALKINETI_JA_005",
      "questionType": "MCQ",
      "difficulty": "JEE_Advanced",
      "bloomLevel": "Analyze",
      "marks": 4,
      "chapter": "Chemical Kinetics",
      "topic": "First-order reactions and half-life",
      "question": "Select ALL correct statements about a first-order reaction.",
      "options": [
        {
          "key": "A",
          "text": "Its half-life is independent of the initial concentration."
        },
        {
          "key": "B",
          "text": "A plot of $\\ln[A]$ versus time is a straight line."
        },
        {
          "key": "C",
          "text": "$t_{1/2} = 0.693/k$."
        },
        {
          "key": "D",
          "text": "The rate is independent of the reactant concentration."
        }
      ],
      "correctAnswer": [
        "A",
        "B",
        "C"
      ],
      "solution": {
        "finalAnswer": "Statements 1, 2 and 3 are correct.",
        "stepByStep": [
          "$[A] = [A]_0 e^{-kt} \\Rightarrow \\ln[A] = \\ln[A]_0 - kt$ (straight line, slope $-k$).",
          "Setting $[A] = [A]_0/2$ gives $t_{1/2} = 0.693/k$, with $[A]_0$ cancelling out.",
          "Rate $= k[A]$ clearly depends on concentration, so the last statement is false."
        ],
        "formulaUsed": [
          "[A] = [A]0 e^{-kt}",
          "t_half = 0.693/k"
        ],
        "commonMistake": "Assuming the rate is constant; that is zero-order behaviour.",
        "examinerNote": "Distinguish rate (depends on $[A]$) from half-life (does not)."
      },
      "qualityChecks": {
        "syllabusAligned": true,
        "classLevelMatched": true,
